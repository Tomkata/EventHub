@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<!-- Page Header -->
<section class="logout-header-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 mx-auto text-center">
                <div class="logout-icon">
                    <i class="bi bi-box-arrow-right"></i>
                </div>
                <h1 class="display-5 fw-bold mb-3">Sign Out</h1>
                <p class="lead mb-0">Come back soon!</p>
            </div>
        </div>
    </div>
</section>

<!-- Logout Section -->
<section class="logout-section py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-xl-5">
                <div class="logout-card">
                    @{
                        if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <div class="text-center p-5">
                                <div class="logout-status-icon mb-4">
                                    <i class="bi bi-person-check"></i>
                                </div>
                                <h3 class="fw-bold mb-3">You're still signed in</h3>
                                <p class="text-muted mb-4">Click the button below to sign out of your EventHub account.</p>
                                
                                <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                                    <button type="submit" class="btn btn-logout">
                                        <i class="bi bi-box-arrow-right me-2"></i> Sign Out Now
                                    </button>
                                </form>
                                
                                <div class="mt-4">
                                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-back-home">
                                        <i class="bi bi-house-door me-2"></i> Back to Home
                                    </a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-center p-5">
                                <div class="logout-success-icon mb-4">
                                    <i class="bi bi-check-circle"></i>
                                </div>
                                <h3 class="fw-bold mb-3">Successfully Signed Out</h3>
                                <p class="text-muted mb-4">You have been safely logged out of EventHub. Thank you for using our platform!</p>
                                
                                <div class="logout-actions">
                                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary-action">
                                        <i class="bi bi-house-door me-2"></i> Go to Home
                                    </a>
                                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-secondary-action">
                                        <i class="bi bi-box-arrow-in-right me-2"></i> Sign In Again
                                    </a>
                                </div>
                                
                                <div class="logout-info mt-4">
                                    <div class="info-box">
                                        <i class="bi bi-info-circle text-primary"></i>
                                        <small class="text-muted">
                                            For your security, we recommend clearing your browser cache if you're using a shared computer.
                                        </small>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
                
                <!-- Quick Actions -->
                <div class="quick-actions mt-4">
                    <div class="row g-3">
                        <div class="col-6">
                            <a asp-area="" asp-controller="Events" asp-action="Index" class="quick-action-card">
                                <i class="bi bi-calendar3"></i>
                                <span>Browse Events</span>
                            </a>
                        </div>
                        <div class="col-6">
                            <a asp-area="" asp-controller="Home" asp-action="Index" class="quick-action-card">
                                <i class="bi bi-house-door"></i>
                                <span>Home Page</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Logout Header */
    .logout-header-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 3rem 0 2rem;
        color: white;
        position: relative;
        overflow: hidden;
    }
    
    .logout-header-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
        opacity: 0.5;
    }
    
    .logout-icon {
        width: 80px;
        height: 80px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        backdrop-filter: blur(10px);
        border: 2px solid rgba(255, 255, 255, 0.3);
        position: relative;
        z-index: 1;
    }
    
    .logout-icon i {
        font-size: 2.5rem;
        color: white;
    }
    
    .logout-header-section h1,
    .logout-header-section p {
        position: relative;
        z-index: 1;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
    }
    
    .logout-header-section p {
        color: rgba(255, 255, 255, 0.9);
    }
    
    /* Logout Section */
    .logout-section {
        background: #f8f9fa;
        min-height: 60vh;
    }
    
    .logout-card {
        background: white;
        border-radius: 25px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        animation: slideUp 0.5s ease-out;
        overflow: hidden;
    }
    
    keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    /* Status Icons */
    .logout-status-icon,
    .logout-success-icon {
        width: 100px;
        height: 100px;
        margin: 0 auto;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
    }
    
    .logout-status-icon {
        background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
        color: #f5576c;
    }
    
    .logout-success-icon {
        background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
        color: #48bb78;
    }
    
    /* Buttons */
    .btn-logout {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 0.875rem 2.5rem;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1.05rem;
        transition: all 0.3s ease;
        box-shadow: 0 5px 20px rgba(102, 126, 234, 0.3);
        display: inline-flex;
        align-items: center;
    }
    
    .btn-logout:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
        color: white;
    }
    
    .btn-back-home {
        background: #e2e8f0;
        color: #64748b;
        border: 2px solid #e2e8f0;
        padding: 0.75rem 2rem;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }
    
    .btn-back-home:hover {
        background: #cbd5e0;
        color: #475569;
        transform: translateY(-2px);
    }
    
    .btn-primary-action {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 0.875rem 2rem;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 5px 20px rgba(102, 126, 234, 0.3);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        margin: 0.5rem;
    }
    
    .btn-primary-action:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
        color: white;
    }
    
    .btn-secondary-action {
        background: white;
        color: #667eea;
        border: 2px solid #e2e8f0;
        padding: 0.875rem 2rem;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        margin: 0.5rem;
    }
    
    .btn-secondary-action:hover {
        background: #f8f9ff;
        border-color: #667eea;
        color: #764ba2;
        transform: translateY(-2px);
    }
    
    /* Logout Actions */
    .logout-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem;
    }
    
    /* Info Box */
    .logout-info {
        padding-top: 1.5rem;
        border-top: 1px solid #e2e8f0;
    }
    
    .info-box {
        background: #f8f9fa;
        padding: 1rem;
        border-radius: 12px;
        display: flex;
        align-items: start;
        gap: 0.75rem;
        text-align: left;
    }
    
    .info-box i {
        font-size: 1.25rem;
        flex-shrink: 0;
        margin-top: 0.1rem;
    }
    
    /* Quick Actions */
    .quick-actions {
        animation: fadeIn 0.5s ease-out 0.3s both;
    }
    
    keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }
    
    .quick-action-card {
        background: white;
        padding: 1.5rem 1rem;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        color: #2d3748;
        transition: all 0.3s ease;
    }
    
    .quick-action-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.2);
        color: #667eea;
    }
    
    .quick-action-card i {
        font-size: 2rem;
        color: #667eea;
    }
    
    .quick-action-card span {
        font-weight: 600;
        font-size: 0.95rem;
    }
    
    /* Responsive */
    media (max-width: 768px) {
        .logout-actions {
            flex-direction: column;
        }
        
        .btn-primary-action,
        .btn-secondary-action {
            width: 100%;
            justify-content: center;
        }
    }
</style>

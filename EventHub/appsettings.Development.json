{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "IdentitySettings": {
    "Password": {
      "RequiredLength": 3,
      "RequireDigit": false,
      "RequireUppercase": false,
      "RequireLowercase": false
    },
    "Lockout": {
      "MaxFailedAttempts": 100,
      "LockoutMinutes": 1
    },
    "Cookie": {
      "ExpireMinutes": 30,
      "IsExpiration": true
    }
  }
}

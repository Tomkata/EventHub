@using EventHub.Web.ViewModels.Events
@model SearchEventByFilterViewModel

<form asp-controller="Events" asp-action="Index" method="get" class="mb-4">
    <div class="card shadow-sm p-4">
        <h5 class="card-title mb-4">
            <i class="bi bi-search"></i> Filter Events
        </h5>

        <div class="row g-3">

            <div class="col-12 col-md-6 col-lg-3">
                <label asp-for="Title" class="form-label fw-semibold">Title</label>
                <input asp-for="Title"
                       class="form-control"
                       placeholder="Search by name..." />
            </div>

            <div class="col-12 col-md-6 col-lg-2">
                <label asp-for="StartDate" class="form-label fw-semibold">From Date</label>
                <input asp-for="StartDate"
                       type="date"
                       class="form-control" />
            </div>

            <div class="col-12 col-md-6 col-lg-2">
                <label asp-for="EndDate" class="form-label fw-semibold">To Date</label>
                <input asp-for="EndDate"
                       type="date"
                       class="form-control" />
            </div>

            <div class="col-12 col-md-6 col-lg-2">
                <label asp-for="LocationId" class="form-label fw-semibold">City</label>
                <select asp-for="LocationId" class="form-select">
                    <option value="">-- Select Location --</option>
                    @foreach (var location in Model.Locations)
                    {
                        <option value="@location.Id">@location.Name</option>
                    }
                </select>
                <span asp-validation-for="LocationId" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-6 col-lg-2">
                <label asp-for="CategoryId" class="form-label fw-semibold">
                    <i class="bi bi-tag text-info"></i> Category
                </label>
                <select asp-for="CategoryId" class="form-select">
                    <option value="">-- Select Category --</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <!-- Buttons -->
            <div class="col-12 col-md-6 col-lg-1 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i>
                </button>

                <a asp-controller="Events"
                   asp-action="Index"
                   class="btn btn-outline-secondary w-100"
                   title="Clear filters">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>

        </div>
    </div>
</form>
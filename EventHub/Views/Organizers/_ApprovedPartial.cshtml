@using EventHub.Web.ViewModels.Organizers
@model ApplyOrganizerForm

<div class="alert alert-success" role="alert">
    <div class="d-flex align-items-center mb-3">
        <i class="bi bi-check-circle fs-3 me-3"></i>
        <div>
            <h5 class="alert-heading mb-1">Congratulations!</h5>
            <p class="mb-0">You are now an approved event organizer.</p>
        </div>
    </div>
    <hr>
    <p class="mb-0">
        <i class="bi bi-info-circle me-1"></i>
        You can now create and manage events on our platform.
    </p>
</div>

<div class="text-center mt-4">
    <a href="@Url.Action("Create", "Events")" class="btn btn-primary me-2">
        <i class="bi bi-plus-circle me-1"></i> Create Event
    </a>
    <a href="@Url.Action("MyEvents", "Events")" class="btn btn-outline-primary">
        <i class="bi bi-calendar3 me-1"></i> My Events
    </a>
</div>
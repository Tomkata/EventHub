@using EventHub.Web.ViewModels.Organizers
@model ApplyOrganizerForm

<div class="alert alert-warning" role="alert">
    <div class="d-flex align-items-center mb-3">
        <i class="bi bi-clock-history fs-3 me-3"></i>
        <div>
            <h5 class="alert-heading mb-1">Application Pending</h5>
            <p class="mb-0">Your organizer application is currently under review.</p>
        </div>
    </div>
    <hr>
    <p class="mb-0">
        <i class="bi bi-info-circle me-1"></i>
        We'll notify you via email once a decision has been made. Thank you for your patience!
    </p>
</div>

<div class="text-center mt-4">
    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-primary">
        <i class="bi bi-house me-1"></i> Return to Home
    </a>
</div>
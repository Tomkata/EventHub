@using EventHub.Web.ViewModels.Organizers
@model ApplyOrganizerForm

<div class="alert alert-info border-0 rounded-3" role="alert">
    <div class="text-center">
        <div class="mb-3">
            <span class="badge bg-warning fs-6 py-2 px-3">
                <i class="bi bi-hourglass-split me-2"></i>Application Pending
            </span>
        </div>
        <h5 class="alert-heading mb-3">We're Reviewing Your Application</h5>
        <p class="text-muted mb-0">
            Thank you for applying! Our team is currently reviewing your application.
            You'll receive an email notification once we've made a decision.
        </p>
        <hr class="my-3">
        <p class="small text-muted mb-0">Typical review time: 3-5 business days</p>
    </div>
</div>
<div class="mt-4">
    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-lg w-100">Back to Home</a>
</div>
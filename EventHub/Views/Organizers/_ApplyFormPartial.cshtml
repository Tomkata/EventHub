@model ApplyOrganizerForm

<form asp-action="Apply" asp-controller="Organizers" method="post">
    <div class="mb-3">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <label asp-for="Email" class="form-label">Email Address <span class="text-danger">*</span></label>
        <input asp-for="Email" type="email" class="form-control form-control-lg" placeholder="Enter your email" required>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Note" class="form-label">Additional Notes</label>
        <textarea asp-for="Note" class="form-control form-control-lg" rows="5" placeholder="Tell us why you want to become an organizer (optional)"></textarea>
        <span asp-validation-for="Note" class="text-danger small"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary btn-lg flex-grow-1">Submit Application</button>
        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary btn-lg">Cancel</a>
    </div>
</form>
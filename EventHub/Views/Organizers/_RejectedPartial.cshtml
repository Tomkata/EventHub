@model ApplyOrganizerForm
@using EventHub.Web.ViewModels.Organizers


<div class="alert alert-danger border-0 rounded-3" role="alert">
    <div class="text-center">
        <div class="mb-3">
            <span class="badge bg-danger fs-6 py-2 px-3">
                <i class="bi bi-x-circle me-2"></i>Application Rejected
            </span>
        </div>
        <h5 class="alert-heading mb-3">Application Not Approved</h5>
        <p class="text-muted mb-0">
            Unfortunately, your application to become an organizer was not approved at this time.
            This doesn't mean you can't apply again in the future.
        </p>
        <hr class="my-3">
        <p class="small text-muted mb-3">
            For more information or to appeal, please contact our support team.
        </p>
    </div>
</div>


<div class="mt-4 d-flex gap-2">
    <a asp-action="Apply" asp-controller="Organizers" class="btn btn-primary">
        Apply Again
    </a>

    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-lg">
        <i class="bi bi-house me-2"></i>Home
    </a>
</div>
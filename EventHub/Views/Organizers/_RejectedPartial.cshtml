@using EventHub.Web.ViewModels.Organizers
@using EventHub.Core.Common.Validation.Organizer
@model ApplyOrganizerForm

<div class="alert alert-danger" role="alert">
    <div class="d-flex align-items-center mb-3">
        <i class="bi bi-x-circle fs-3 me-3"></i>
        <div>
            <h5 class="alert-heading mb-1">Application Rejected</h5>
            <p class="mb-0">Your organizer application was not approved at this time.</p>
        </div>
    </div>
    <hr>
    <p class="mb-0">
        <i class="bi bi-info-circle me-1"></i>
        You may reapply after @OrganizerValidation.OrganizerCooldownDays days from the rejection date.
    </p>
</div>

<div class="text-center mt-4">
    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-primary">
        <i class="bi bi-house me-1"></i> Return to Home
    </a>
</div>
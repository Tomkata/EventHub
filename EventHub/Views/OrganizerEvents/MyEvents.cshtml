@using EventHub.Services.Common
﻿@using EventHub.Web.ViewModels.Events
@model PagedResult<EventListViewModel>

@{
    ViewData["Title"] = "My Events";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="bi bi-calendar-check"></i> My Events
        </h1>
        <a href="@Url.Action("Create", "Events")" class="btn btn-success btn-lg">
            <i class="bi bi-plus-circle me-2"></i> Create Event
        </a>
    </div>

    @await Html.PartialAsync("_EventsList", Model);

    @await Html.PartialAsync("_Pagination", new PaginationViewModel
    {
        CurrentPageNumber = Model.CurrentPageNumber,
        TotalPages = Model.TotalPages,
        TotalRecords = Model.TotalRecords
    })
    ;
</div>
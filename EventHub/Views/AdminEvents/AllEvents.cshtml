@using EventHub.Services.Common
@using EventHub.Web.ViewModels.Events
@model PagedResult<EventListViewModel>

@{
    ViewData["Title"] = "Admin Panel - All Events";
}

<div class="bg-danger text-white py-3 mb-5">
    <div class="container-fluid">
        <div class="d-flex align-items-center gap-3">
            <i class="bi bi-shield-lock fs-3"></i>
            <div>
                <h2 class="mb-0">
                    <i class="bi bi-gear-fill me-2"></i> Admin Panel
                </h2>
                <small>Manage all events</small>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-6 fw-bold">
            <i class="bi bi-calendar3"></i> All Events
        </h1>

    </div>

  

    @await Html.PartialAsync("_EventsList", Model)
    
    @await Html.PartialAsync("_Pagination", new PaginationViewModel
    {
        CurrentPageNumber = Model.CurrentPageNumber,
        TotalPages = Model.TotalPages,
        TotalRecords = Model.TotalRecords
    })
</div>
    
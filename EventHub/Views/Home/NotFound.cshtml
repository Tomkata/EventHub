@{
    ViewData["Title"] = "Page Not Found";
}

@section Styles {
    <style>
        .error-page {
            min-height: calc(100vh - 200px);
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #f5f7ff 0%, #f0f2ff 100%);
        }

        .error-card {
            background: white;
            border-radius: 20px;
            padding: 3rem 4rem;
            text-align: center;
            box-shadow: 0 10px 40px rgba(102, 126, 234, 0.15);
            max-width: 560px;
            width: 100%;
        }

        .error-code {
            font-size: 7rem;
            font-weight: 800;
            line-height: 1;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.5rem;
        }

        .error-icon {
            font-size: 3.5rem;
            color: #667eea;
            margin-bottom: 1rem;
        }

        .error-title {
            font-size: 1.75rem;
            font-weight: 700;
            color: #2d3748;
            margin-bottom: 0.75rem;
        }

        .error-message {
            color: #718096;
            font-size: 1rem;
            line-height: 1.6;
            margin-bottom: 2rem;
        }

        .error-actions .btn-primary-custom {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            color: white;
            padding: 0.75rem 2rem;
            border-radius: 50px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            transition: transform 0.2s, box-shadow 0.2s;
            margin: 0.25rem;
        }

        .error-actions .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
            color: white;
        }

        .error-actions .btn-outline-custom {
            border: 2px solid #667eea;
            color: #667eea;
            padding: 0.75rem 2rem;
            border-radius: 50px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            background: transparent;
            transition: all 0.2s;
            margin: 0.25rem;
        }

        .error-actions .btn-outline-custom:hover {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-color: transparent;
        }
    </style>
}

<div class="error-page">
    <div class="error-card">
        <div class="error-code">404</div>
        <div class="error-icon">
            <i class="bi bi-map"></i>
        </div>
        <h1 class="error-title">Page Not Found</h1>
        <p class="error-message">
            The page you are looking for does not exist, may have been moved, or is temporarily unavailable.
        </p>
        <div class="error-actions">
            <a asp-controller="Home" asp-action="Index" class="btn-primary-custom">
                <i class="bi bi-house-door me-2"></i>Go Home
            </a>
            <a asp-controller="Events" asp-action="Index" class="btn-outline-custom">
                <i class="bi bi-calendar3 me-2"></i>Browse Events
            </a>
        </div>
    </div>
</div>

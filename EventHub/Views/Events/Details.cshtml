@using EventHub.Core.ViewModels.Events
@model DetailedEventViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-5">
    <!-- Event Image -->
    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <div class="text-center mb-4">
            <img src="/@Model.ImagePath" alt="@Model.Title" class="img-fluid rounded" style="max-height: 400px; object-fit: cover;">
        </div>
    }

    <!-- Event Details -->
    <div class="row justify-content-center mb-4">
        <div class="col-md-8">
            <!-- Title -->
            <h1 class="mb-3">@Model.Title</h1>

            <!-- Category and City Badges -->
            <div class="mb-3">
                <span class="badge bg-primary me-2">@Model.Category</span>
                <span class="badge bg-info">@Model.CityName</span>
            </div>

            <!-- Dates -->
            <div class="mb-3">
                <div class="row">
                    <div class="col-md-6">
                        <p class="text-muted">
                            <strong>Start Date:</strong><br>
                            @Model.StartDate.ToString("MMMM dd, yyyy HH:mm")
                        </p>
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted">
                            <strong>End Date:</strong><br>
                            @Model.EndDate.ToString("MMMM dd, yyyy HH:mm")
                        </p>
                    </div>
                </div>
            </div>

            <!-- Description -->
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="mb-4">
                    <h5 class="mb-2">Description</h5>
                    <p class="text-secondary">@Model.Description</p>
                </div>
            }

            <!-- Participants Count -->
            <div class="mb-4 p-3 bg-light rounded">
                <h5 class="mb-2">Participants</h5>
                <p class="mb-0">
                    <strong>@Model.ParticipantsCount</strong> out of <strong>@Model.MaxParticipants</strong> participants
                </p>
            </div>

            <!-- Participants List -->
            <div class="mb-4">
                <h5 class="mb-3">Attendees</h5>
                @if (Model.Participants != null && Model.Participants.Any())
                {
                    <ul class="list-group">
                        @foreach (var participant in Model.Participants)
                        {
                            <li class="list-group-item">@participant.UserName</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">No participants yet. Be the first to join!</p>
                }
            </div>

            <!-- Action Buttons -->
            <div class="d-flex gap-2 justify-content-center">
                <a href="@Url.Action("Index", "Events")" class="btn btn-secondary">Back to Events</a>

                @if (User.IsInRole("Admin"))
                {
                    <a href="@Url.Action("Edit", "Events", new { id = Model.Id })" class="btn btn-primary">Edit</a>
                    <a href="@Url.Action("Delete", "Events", new { id = Model.Id })" class="btn btn-danger">Delete</a>
                }
            </div>
        </div>
    </div>
</div>
@using EventHub.Web.ViewModels.Events
@model DetailedEventViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/views/event-details.css" asp-append-version="true" />

}

@{
    ViewData["Title"] = Model.Title;
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}


<div class="container mt-5">
    <!-- Event Image -->
    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <div class="text-center mb-4">
            <img src="/@Model.ImagePath" alt="@Model.Title" class="img-fluid rounded" style="max-height: 400px; object-fit: cover;">
        </div>
    }

    <!-- Event Details -->
    <div class="row justify-content-center mb-4">
        <div class="col-md-8">
            <!-- Title -->
            <h1 class="mb-3">@Model.Title</h1>

            <!-- Category and City Badges -->
            <div class="mb-3">
                <span class="badge bg-primary me-2">@Model.Category</span>
                <span class="badge bg-info">@Model.CityName</span>
            </div>

            <!-- Dates -->
            <div class="mb-3">
                <div class="row">
                    <div class="col-md-6">
                        <p class="text-muted">
                            <strong>Start Date:</strong><br>
                            @Model.StartDate.ToString("MMMM dd, yyyy HH:mm")
                        </p>
                    </div>
                    <div class="col-md-6">
                        <p class="text-muted">
                            <strong>End Date:</strong><br>
                            @Model.EndDate.ToString("MMMM dd, yyyy HH:mm")
                        </p>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="mb-4">
                    <h5 class="mb-2">Description</h5>
                    <p class="text-secondary">@Model.Description</p>
                </div>
            }

            <!-- Participants Count -->
            <div class="mb-4 p-3 bg-light rounded">
                <h5 class="mb-2">Participants</h5>
                <p class="mb-0">
                    <strong>@Model.ParticipantsCount</strong> out of <strong>@Model.MaxParticipants</strong> participants
                </p>
            </div>

            <!-- Participants List -->
            <h5 class="mb-3">Attendees</h5>

            <!-- Attendees Button -->
            <button type="button" class="btn-attendees" data-bs-toggle="modal" data-bs-target="#attendeesModal">
                <i class="bi bi-people-fill me-2"></i>
               View Attendees
                <span class="attendees-count">@Model.Participants.Count()</span>
            </button>

            <!-- Modal -->
            <div class="modal fade" id="attendeesModal" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content attendees-modal">

                        <div class="modal-header border-0 pb-0">
                            <div>
                                <h5 class="modal-title fw-bold">Attendees</h5>
                                <p class="text-muted small mb-0">@Model.ParticipantsCount out of @Model.MaxParticipants spots filled</p>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>

                            

                        <div class="modal-body pt-1">
                            @if (Model.Participants != null && Model.Participants.Any())
                            {
                                <ul class="attendee-list">
                                    @foreach (var participant in Model.Participants)
                                    {
                                        <li class="attendee-item">
                                            @if (!string.IsNullOrEmpty(participant.ProfileImagePath))
                                            {
                                                <img src="~/@participant.ProfileImagePath"
                                                     class="attendee-avatar"
                                                     alt="@participant.DisplayName" />
                                            }
                                            else
                                            {
                                                <div class="attendee-avatar-placeholder">
                                                    @participant.DisplayName.FirstOrDefault()
                                                </div>
                                            }
                                            <a asp-controller="UserProfile"
                                                   asp-action="Public"
                                                   asp-route-userId="@participant.UserId"
                                                   asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                                                   class="attendee-name">
                                                @participant.DisplayName
                                            </a>
                                            <i class="bi bi-chevron-right text-muted ms-auto small"></i>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="empty-attendees">
                                    <i class="bi bi-people" style="font-size: 2.5rem; color: #c4b5fd;"></i>
                                    <p class="mt-2 text-muted">No participants yet.<br />Be the first to    !</p>
                                </div>
                            }
                        </div>

                    </div>
                </div>
            </div>


            <div class="d-flex gap-2 justify-content-center">
                <a href="@Url.Action("Index", "Events")" class="btn btn-secondary mb-3">Back to Events</a>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Events" asp-action="Update"
                       asp-route-eventId="@Model.Id"
                       class="btn btn-primary mb-3">Edit</a>
                }

                @if (User.IsInRole("Admin"))
                {
                    <form asp-controller="Events"
                          asp-action="Delete"
                          method="post"
                          class="d-inline">

                        <input type="hidden" name="eventId" value="@Model.Id" />
                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn btn-danger w-100 mb-2">
                            Delete
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

    
   
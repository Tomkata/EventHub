@using EventHub.Web.ViewModels.Events
@using EventHub.Services.Common
@model EventsIndexViewModel

@{
    ViewData["Title"] = "Events";
}

<div class="container py-5">
    <h1 class="mb-4">
        <i class="bi bi-calendar3"></i> Browse Events
    </h1>

    @await Html.PartialAsync("_SearchForm", Model.Search)

    @await Html.PartialAsync("_EventsList", Model.Paged)

    @await Html.PartialAsync("_Pagination", new PaginationViewModel
    {
        CurrentPageNumber = Model.Paged.CurrentPageNumber,
        TotalPages = Model.Paged.TotalPages,
        TotalRecords = Model.Paged.TotalRecords
    })
</div>
@model EventHub.Web.ViewModels.Chat.ConversationViewModel

@{
    ViewData["Title"] = $"Chat with {Model.OtherUserName}";
    var avatar = string.IsNullOrEmpty(Model.OtherUserProfileImagePath)
        ? Url.Content("~/images/default-avatar.jpg")
        : Url.Content("~/" + Model.OtherUserProfileImagePath);
}

@section Styles {
    <style>
        .chat-wrapper {
            height: calc(100vh - 120px);
            display: flex;
            flex-direction: column;
        }

        .chat-header {
            background: linear-gradient(135deg, #1e1b4b 0%, #4338ca 100%);
            color: white;
            padding: 1rem 1.5rem;
            border-radius: 16px 16px 0 0;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 1.5rem;
            background: #f8f9fa;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .message-bubble {
            max-width: 65%;
            padding: 10px 15px;
            border-radius: 18px;
            font-size: 0.95rem;
            word-break: break-word;
        }

        .message-mine {
            align-self: flex-end;
            background: linear-gradient(135deg, #4338ca, #6366f1);
            color: white;
            border-bottom-right-radius: 4px;
        }

        .message-theirs {
            align-self: flex-start;
            background: white;
            color: #1e1b4b;
            border-bottom-left-radius: 4px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.08);
        }

        .message-time {
            font-size: 0.7rem;
            opacity: 0.6;
            margin-top: 3px;
            text-align: right;
        }

        .chat-input-area {
            background: white;
            padding: 1rem 1.5rem;
            border-top: 1px solid #e5e7eb;
            border-radius: 0 0 16px 16px;
            display: flex;
            gap: 10px;
            align-items: center;
        }

            .chat-input-area input {
                flex: 1;
                border: 1px solid #e5e7eb;
                border-radius: 25px;
                padding: 10px 18px;
                outline: none;
                font-size: 0.95rem;
            }

                .chat-input-area input:focus {
                    border-color: #4338ca;
                    box-shadow: 0 0 0 3px rgba(67,56,202,0.1);
                }

        .btn-send {
            background: linear-gradient(135deg, #4338ca, #6366f1);
            color: white;
            border: none;
            border-radius: 50%;
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: transform 0.15s;
        }

            .btn-send:hover {
                transform: scale(1.08);
            }

            .btn-send:disabled {
                opacity: 0.5;
                cursor: not-allowed;
                transform: none;
            }
    </style>
}

<div class="container py-4">
    <div class="chat-wrapper shadow rounded-4">

        <div class="chat-header">
            <a asp-controller="Chat" asp-action="Index" class="text-white me-2">
                <i class="bi bi-arrow-left fs-5"></i>
            </a>
            <img src="@avatar"
                 onerror="this.src='/images/default-avatar.jpg'"
                 style="width:42px;height:42px;border-radius:50%;object-fit:cover;border:2px solid rgba(255,255,255,0.5);" />
            <div>
                <div class="fw-semibold">@Model.OtherUserName</div>
            </div>
        </div>

        <div class="chat-messages" id="messages">
            @foreach (var msg in Model.Messages)
            {
                var isMine = msg.SenderId == Model.CurrentUserId;
                <div class="d-flex flex-column @(isMine ? "align-items-end" : "align-items-start")">
                    <div class="message-bubble @(isMine ? "message-mine" : "message-theirs")">
                        @msg.Content
                        <div class="message-time" data-utc="@msg.CreatedAt.ToString("o")"></div>
                    </div>
                </div>
            }
        </div>

        <div class="chat-input-area">
            <input id="messageInput" type="text" placeholder="Type a message..." />
            <button id="sendButton" class="btn-send" onclick="sendMessage()" disabled>
                <i class="bi bi-send-fill"></i>
            </button>
        </div>

    </div>
</div>

<script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
<script>
    const conversationId = "@Model.ConversationId";
    const currentUserId = "@Model.CurrentUserId";
</script>
<script src="~/js/chat.js"></script>
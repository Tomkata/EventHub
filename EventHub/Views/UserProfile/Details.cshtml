@using EventHub.Web.ViewModels.UserProfile
@model DetailedUserProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    var message = TempData["SuccessMessage"];
}
    
@if (message != null)
{
    <h2 class="alert alert-success">@message</h2>
}
<div class="profile-page container py-5">

    <div class="profile-hero row align-items-center mb-5 p-4 rounded-4"
         style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); color: white;">

        <div class="col-auto">
            @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
            {
                <img src="/@Model.ProfileImagePath"
                     class="rounded-circle border border-4 border-white shadow"
                     style="width: 110px; height: 110px; object-fit: cover;" />
            }
            else
            {
                <div class="rounded-circle border border-4 border-white shadow d-flex align-items-center justify-content-center"
                     style="width: 110px; height: 110px; background: rgba(255,255,255,0.2); font-size: 2.5rem;">
                    👤
                </div>
            }
        </div>

        <div class="col">
            <h1 class="fw-bold mb-1">@Model.FirstName @Model.LastName</h1>
            <p class="mb-1 opacity-75">
                <i class="bi bi-geo-alt-fill me-1"></i>@Model.Location
            </p>
            <p class="mb-0 opacity-75">
                <i class="bi bi-telephone-fill me-1"></i>@Model.PhoneNumber
            </p>
        </div>

       
        
        <div class="col-auto d-flex gap-2">
        <a asp-controller="UserProfile" asp-action="MyFollowers"
               class="btn fw-semibold px-4"
               style="background: rgba(255,255,255,0.15); color: white; border: 1.5px solid rgba(255,255,255,0.4); border-radius: 10px;">
            <i class="bi bi-people-fill me-1"></i> Followers
            <span class="badge ms-1 rounded-pill"
                  style="background: rgba(255,255,255,0.25); font-size: 0.75rem;">
                @Model.FollowersCount
            </span>
        </a>
        <a asp-controller="UserProfile" asp-action="MyFollowing"
               class="btn fw-semibold px-4"
               style="background: rgba(255,255,255,0.15); color: white; border: 1.5px solid rgba(255,255,255,0.4); border-radius: 10px;">
            <i class="bi bi-person-check-fill me-1"></i> Following
            <span class="badge ms-1 rounded-pill"
                  style="background: rgba(255,255,255,0.25); font-size: 0.75rem;">
                @Model.FollowingCount
            </span>
        </a>
        <a asp-controller="UserProfile" asp-action="Update"
               class="btn btn-light fw-semibold px-4">
            <i class="bi bi-pencil me-1"></i> Edit Profile
        </a>
    </div>

    </div>

    <div class="row g-4">

        <div class="col-md-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-person-lines-fill me-2 text-primary"></i>About Me
                    </h5>
                    <p class="text-secondary">
                        @(string.IsNullOrEmpty(Model.Description) ? "No description yet." : Model.Description)
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-5 d-flex flex-column gap-4">

            <div class="card border-0 shadow-sm rounded-4"
                 style="background: linear-gradient(135deg, #6366f1, #8b5cf6); color: white;">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <p class="mb-1 opacity-75 small">Events Joined</p>
                        <h2 class="fw-bold mb-0">@Model.JoinedEventsCount</h2>
                    </div>
                    <i class="bi bi-calendar-check" style="font-size: 2.5rem; opacity: 0.5;"></i>
                </div>
                <div class="card-footer border-0 bg-transparent pb-3 px-4">
                    <a asp-controller="Participants" asp-action="MyJoinedEvents"
                           class="btn btn-light btn-sm fw-semibold w-100">
                        <i class="bi bi-arrow-right me-1"></i> View My Events
                    </a>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-stars me-2 text-warning"></i>Interests
                    </h5>
                    @if (Model.Interests.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var interest in Model.Interests)
                            {
                                <span class="badge rounded-pill px-3 py-2"
                                      style="background: rgba(99,102,241,0.1); color: #6366f1; font-size: 0.85rem;">
                                    @interest
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No interests added yet.</p>
                    }
                </div>
            </div>

        </div>
    </div>
</div>
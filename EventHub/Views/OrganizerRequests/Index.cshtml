@using EventHub.Services.Common
@using EventHub.Web.ViewModels.Organizers
@using EventHub.Core.Enums.Organizer
@model PagedResult<AllRequestsViewModel>

@{
    ViewData["Title"] = "Admin Panel – Organizer Requests";
    var currentStatus = Context.Request.Query["status"].ToString();
}

<style>
    .admin-page {
        background: #f8f7ff;
        min-height: 100vh;
        padding: 2.5rem 0;
    }

    .admin-header {
        background: linear-gradient(135deg, #1e1b4b 0%, #4338ca 100%);
        border-radius: 20px;
        padding: 2rem 2.5rem;
        color: white;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .admin-header h1 {
        font-size: 1.8rem;
        font-weight: 700;
        margin: 0;
    }

    .admin-header p {
        opacity: 0.65;
        margin: 0.3rem 0 0;
        font-size: 0.9rem;
    }

    .filter-tabs {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        background: white;
        padding: 0.5rem;
        border-radius: 14px;
        box-shadow: 0 2px 12px rgba(99,102,241,0.07);
        width: fit-content;
    }

    .filter-tab {
        padding: 0.45rem 1.25rem;
        border-radius: 10px;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        color: #6b7280;
        transition: all 0.2s;
        border: none;
        background: transparent;
    }

    .filter-tab:hover {
        background: #f3f4f6;
        color: #4338ca;
    }

    .filter-tab.active {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: white;
    }

    .request-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 2px 12px rgba(99,102,241,0.06);
        padding: 1.5rem;
        margin-bottom: 1rem;
        transition: box-shadow 0.2s, transform 0.2s;
        border: 1.5px solid transparent;
    }

    .request-card:hover {
        box-shadow: 0 6px 24px rgba(99,102,241,0.13);
        transform: translateY(-1px);
        border-color: #e0e7ff;
    }

    .user-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
        color: white;
    }

    .badge-status {
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .badge-pending  { background: #fef3c7; color: #92400e; }
    .badge-approved { background: #d1fae5; color: #065f46; }
    .badge-rejected { background: #fee2e2; color: #991b1b; }

    .note-box {
        background: #f5f3ff;
        border-left: 3px solid #6366f1;
        border-radius: 0 8px 8px 0;
        padding: 0.5rem 0.75rem;
        font-size: 0.875rem;
        color: #4b5563;
        margin-top: 0.5rem;
    }

    .btn-approve {
        background: #d1fae5;
        color: #065f46;
        border: none;
        border-radius: 10px;
        padding: 6px 16px;
        font-weight: 600;
        font-size: 0.875rem;
        transition: all 0.2s;
    }

    .btn-approve:hover { background: #a7f3d0; color: #064e3b; }

    .btn-reject {
        background: #fee2e2;
        color: #991b1b;
        border: none;
        border-radius: 10px;
        padding: 6px 16px;
        font-weight: 600;
        font-size: 0.875rem;
        transition: all 0.2s;
    }

    .btn-reject:hover { background: #fecaca; color: #7f1d1d; }

    .btn-demote {
        background: #fef3c7;
        color: #92400e;
        border: none;
        border-radius: 10px;
        padding: 6px 16px;
        font-weight: 600;
        font-size: 0.875rem;
        transition: all 0.2s;
    }

    .btn-demote:hover { background: #fde68a; color: #78350f; }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: white;
        border-radius: 16px;
        box-shadow: 0 2px 12px rgba(99,102,241,0.06);
    }

    .stats-row {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .stat-chip {
        background: white;
        border-radius: 12px;
        padding: 0.75rem 1.25rem;
        box-shadow: 0 2px 8px rgba(99,102,241,0.07);
        font-size: 0.875rem;
        font-weight: 600;
        color: #6b7280;
    }

    .stat-chip span {
        font-size: 1.2rem;
        font-weight: 700;
        color: #4338ca;
        margin-right: 0.4rem;
    }
</style>

<div class="admin-page">
    <div class="container" style="max-width: 900px;">

        <!-- Header -->
        <div class="admin-header">
            <div>
                <h1><i class="bi bi-shield-check me-2"></i>Admin Panel</h1>
                <p>Manage organizer requests and permissions</p>
            </div>
            <a href="@Url.Action("Index", "Home")" class="btn btn-light fw-semibold px-4">
                <i class="bi bi-house me-1"></i> Home
            </a>
        </div>

        <!-- Stats -->
        <div class="stats-row">
            <div class="stat-chip">
                <span>@Model.Data.Count()</span> Total
            </div>
            <div class="stat-chip">
                <span>@Model.Data.Count(x => x.Status == Status.Pending)</span> Pending
            </div>
            <div class="stat-chip">
                <span>@Model.Data.Count(x => x.Status == Status.Approved)</span> Approved
            </div>
            <div class="stat-chip">
                <span>@Model.Data.Count(x => x.Status == Status.Rejected)</span> Rejected
            </div>
        </div>

        <!-- Filter Tabs -->
        <div class="filter-tabs">
            <a href="@Url.Action("Index")" class="filter-tab @(string.IsNullOrEmpty(currentStatus) ? "active" : "")">
                All
            </a>
            <a href="@Url.Action("Index", new { status = Status.Pending })" 
               class="filter-tab @(currentStatus == "Pending" ? "active" : "")">
                Pending
            </a>
            <a href="@Url.Action("Index", new { status = Status.Approved })" 
               class="filter-tab @(currentStatus == "Approved" ? "active" : "")">
                Approved
            </a>
            <a href="@Url.Action("Index", new { status = Status.Rejected })" 
               class="filter-tab @(currentStatus == "Rejected" ? "active" : "")">
                Rejected
            </a>
        </div>

        @if (Model.Data.Any())
        {
            @foreach (var request in Model.Data)
            {
                <div class="request-card">
                    <div class="d-flex align-items-center gap-3">

                        <!-- Avatar -->
                        <div class="user-avatar"
                             style="background: linear-gradient(135deg, #6366f1, #8b5cf6);">
                            <i class="bi bi-person-fill"></i>
                        </div>

                        <!-- Info -->
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <strong>@request.Email</strong>
                                <span class="badge-status badge-@request.Status.ToString().ToLower()">
                                    @request.Status
                                </span>
                            </div>
                            <div class="text-muted small mt-1">
                                <i class="bi bi-calendar3 me-1"></i>
                                Applied @request.CreatedAt.ToString("dd MMM yyyy")
                            </div>
                            @if (!string.IsNullOrEmpty(request.Note))
                            {
                                <div class="note-box">
                                    <i class="bi bi-chat-quote me-1"></i>@request.Note
                                </div>
                            }
                        </div>

                        <!-- Actions -->
                        <div class="d-flex gap-2 flex-shrink-0">
                            @if (request.Status == Status.Pending)
                            {
                                <form asp-action="ApproveRequest" asp-controller="OrganizerRequests" method="post">
                                    <input type="hidden" name="UserId" value="@request.UserId" />
                                    <input type="hidden" name="Id" value="@request.Id" />
                                    <input type="hidden" name="Email" value="@request.Email" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-approve">
                                        <i class="bi bi-check-lg me-1"></i>Approve
                                    </button>
                                </form>

                                <form asp-action="RejectRequest" asp-controller="OrganizerRequests" method="post">
                                    <input type="hidden" name="UserId" value="@request.UserId" />
                                    <input type="hidden" name="Id" value="@request.Id" />
                                    <input type="hidden" name="Email" value="@request.Email" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-reject">
                                        <i class="bi bi-x-lg me-1"></i>Reject
                                    </button>
                                </form>
                            }

                            @if (request.Status == Status.Approved)
                            {
                                <form asp-action="DemoteOrganizer" asp-controller="OrganizerRequests" method="post">
                                    <input type="hidden" name="userId" value="@request.UserId" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-demote">
                                        <i class="bi bi-arrow-down-circle me-1"></i>Demote
                                    </button>
                                </form>
                            }
                        </div>
                         
                    </div>
                    
                </div>
            }
             @await Html.PartialAsync("_Pagination", new PaginationViewModel
                            {
                                CurrentPageNumber = Model.CurrentPageNumber,
                                TotalPages = Model.TotalPages,
                                TotalRecords = Model.TotalRecords
                            })
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-inbox" style="font-size: 3rem; color: #c4b5fd;"></i>
                <h5 class="mt-3 text-muted">No requests found</h5>
                <p class="text-muted small">There are no requests matching the current filter.</p>
            </div>
        }

    </div>
</div>
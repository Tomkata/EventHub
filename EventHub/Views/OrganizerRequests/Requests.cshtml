@using EventHub.Web.ViewModels.Organizers
@model IEnumerable<OrganizerRequestViewModel>

@{
    ViewData["Title"] = "Organizer Requests";
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="container-fluid py-5 bg-light min-vh-100">
    <div class="container">
        <!-- Header Section -->
        <div class="mb-5">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-5 fw-bold mb-2">
                        <i class="bi bi-clipboard-check text-primary me-3"></i>Organizer Requests
                    </h1>
                    <p class="text-muted fs-6">Review and manage pending organizer applications</p>
                </div>
                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-lg">
                    <i class="bi bi-house me-2"></i>Back to Home
                </a>
            </div>
            <hr class="my-4">
        </div>

        <!-- Requests List -->
        @if (Model != null && Model.Any())
        {
            <div class="row g-4">
                @foreach (var request in Model)
                {
                    <div class="col-12">
                        <div class="card border-0 shadow-sm hover-shadow transition">
                            <div class="card-body p-4">
                                <div class="row align-items-center">
                                    <!-- Left Section: User Info -->
                                    <div class="col-md-7">
                                        <div class="d-flex align-items-start gap-3">
                                            <!-- Avatar -->
                                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                                                 style="width: 60px; height: 60px; flex-shrink: 0;">
                                                <i class="bi bi-envelope-fill fs-5"></i>
                                            </div>

                                            <!-- User Details -->
                                            <div class="flex-grow-1">
                                                <h5 class="card-title mb-1">
                                                    <a href="mailto:@request.Email" class="text-decoration-none">@request.Email</a>
                                                </h5>
                                                <p class="text-muted mb-2">
                                                    <i class="bi bi-calendar me-1"></i>
                                                    Applied on: <strong>@request.CreatedRequestDate.ToString("MMMM dd, yyyy")</strong>
                                                </p>

                                                @if (!string.IsNullOrEmpty(request.Note))
                                                {
                                                    <div class="bg-light p-2 rounded mt-2 border-start border-4 border-primary">
                                                        <p class="mb-0 small text-muted">
                                                            <strong>Note:</strong> @request.Note
                                                        </p>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Right Section: Actions -->
                                    <div class="col-md-5">
                                        <div class="d-flex gap-2 flex-wrap justify-content-md-end">
                                            <form asp-action="ApproveRequest" asp-controller="OrganizerRequests"
                                                  asp-route-id="@request.Id" asp-route-email="@request.Email"
                                                  asp-route-note="@request.Note" asp-route-createDate="@request.CreatedRequestDate" 
                                                  asp-route-userId="@request.UserId" method="post" style="display: inline;">
                                                <button type="submit" class="btn btn-success btn-lg rounded-3"
                                                        title="Approve this application">
                                                    <i class="bi bi-check-circle me-2"></i>Approve
                                                </button>
                                            </form>

                                            <form asp-action="RejectRequest" asp-controller="OrganizerRequests"
                                                  asp-route-id="@request.Id" asp-route-email="@request.Email"
                                                  asp-route-note="@request.Note" asp-route-createDate="@request.CreatedRequestDate"
                                                  asp-route-userId="@request.UserId" method="post" style="display: inline;">
                                                <button type="submit" class="btn btn-danger btn-lg rounded-3"
                                                        title="Reject this application">
                                                    <i class="bi bi-x-circle me-2"></i>Reject
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="text-center py-5">
                <div class="mb-4">
                    <i class="bi bi-inbox fs-1 text-muted"></i>
                </div>
                <h4 class="text-muted mb-2">No Requests Found</h4>
                <p class="text-muted mb-4">There are no pending organizer applications to review.</p>
                <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-lg">
                    <i class="bi bi-house me-2"></i>Back to Home
                </a>
            </div>
        }
    </div>
</div>

<style>
    .hover-shadow {
        transition: box-shadow 0.3s ease;
    }

    .hover-shadow:hover {
        box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.15) !important;
    }

    .transition {
        transition: all 0.3s ease;
    }

    .min-vh-100 {
        min-height: 100vh;
    }
</style>
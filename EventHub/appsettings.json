{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=EventHub;Trusted_Connection=True;TrustServerCertificate=True;",
    "ApplicationDbContextConnection": "Server=(localdb)\\mssqllocaldb;Database=EventHub.Web;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "IdentitySettings": {
    "Password": {
      "RequiredLength": 3,
      "RequireDigit": false,
      "RequireUppercase": false,
      "RequireLowercase": false
    },
    "Lockout": {
      "MaxFailedAttempts": 100,
      "LockoutMinutes": 1
    },
    "Cookie": {
      "ExpireMinutes": 30,
      "IsExpiration": true
    }
  },

  "AllowedHosts": "*"
}